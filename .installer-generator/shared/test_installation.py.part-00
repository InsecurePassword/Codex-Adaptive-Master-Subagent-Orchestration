#!/usr/bin/env python3
"""Integration tests for install_package.py using only the Python standard library."""

from __future__ import annotations

import importlib.util
import json
import os
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path

from process_utils import run_bounded
from types import ModuleType

ROOT = Path(__file__).resolve().parents[1]
INSTALLER = ROOT / "scripts" / "install_package.py"
PLUGIN = json.loads((ROOT / ".codex-plugin" / "plugin.json").read_text(encoding="utf-8"))["name"]
OPTION_LABEL = (ROOT / "PACKAGE-OPTION").read_text(encoding="utf-8").strip()
OPTION = OPTION_LABEL.split()[1]
MANAGED = "# managed-by: adaptive-master-subagent-orchestration"
COMMAND_TIMEOUT = 45
ALL_NAMES = {
    "adaptive-master-subagent-orchestration-option-a-two-skill",
    "adaptive-master-subagent-orchestration-option-b-unified",
    "adaptive-master-subagent-orchestration-option-c-installer-required",
    "adaptive-master-subagent-orchestration-option-a-modular",
    "adaptive-master-subagent-orchestration-option-c-lean",
    "adaptive-master-subagent-orchestration",
}


def require(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)


def step(message: str) -> None:
    print(f"[installation-test:{OPTION}] {message}", flush=True)


def command(home: Path, *args: str) -> list[str]:
    return [sys.executable, "-E", "-s", "-S", str(INSTALLER), "--home", str(home), *args]


def run(home: Path, *args: str, expect: int = 0, env: dict[str, str] | None = None) -> str:
    try:
        result = subprocess.run(
            command(home, *args),
            text=True,
            capture_output=True,
            check=False,
            env=env,
            timeout=COMMAND_TIMEOUT,
        )
    except subprocess.TimeoutExpired as exc:
        raise AssertionError(f"installer command timed out after {COMMAND_TIMEOUT}s: {command(home, *args)}") from exc
    if result.returncode != expect:
        raise AssertionError(
            f"command returned {result.returncode}, expected {expect}: {result.args}\n"
            f"stdout={result.stdout}\nstderr={result.stderr}"
        )
    return result.stdout + result.stderr


def marketplace(home: Path) -> dict[str, object]:
    path = home / ".agents" / "plugins" / "marketplace.json"
    return json.loads(path.read_text(encoding="utf-8"))


def active_ams_plugins(home: Path) -> list[str]:
    root = home / ".agents" / "plugins" / "plugins"
    if not root.exists():
        return []
    return sorted(path.name for path in root.iterdir() if path.name in ALL_NAMES)


def ams_marketplace_entries(home: Path) -> list[str]:
    data = marketplace(home)
    plugins = data.get("plugins", [])
    return sorted(
        item["name"]
        for item in plugins
        if isinstance(item, dict) and item.get("name") in ALL_NAMES
    )


def load_installer_module(path: Path = INSTALLER) -> ModuleType:
    spec = importlib.util.spec_from_file_location(f"ams_installer_under_test_{OPTION}_{id(path)}", path)
    if spec is None or spec.loader is None:
        raise AssertionError("could not load installer module")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def test_timeout_helper(base: Path) -> None:
    module = load_installer_module()
    args = module.parse_args(["--home", str(base / "timeout-home"), "--exclude-spark"])
    original_command = module.bootstrap_command
    old_timeout = os.environ.get("AMS_PROFILE_TIMEOUT_SECONDS")
    os.environ["AMS_PROFILE_TIMEOUT_SECONDS"] = "1"
    module.bootstrap_command = lambda *a, **k: [sys.executable, "-c", "import time; time.sleep(5)"]
    try:
        try:
            module.run_bootstrap(ROOT, base / "timeout-codex", args, dry_run=True, quiet=True)
        except SystemExit as exc:
            require("exceeded 1 seconds" in str(exc), f"timeout error was unclear: {exc}")
        else:
            raise AssertionError("bootstrap timeout was not enforced")
    finally:
        module.bootstrap_command = original_command
        if old_timeout is None:
            os.environ.pop("AMS_PROFILE_TIMEOUT_SECONDS", None)
        else:
            os.environ["AMS_PROFILE_TIMEOUT_SECONDS"] = old_timeout


def test_rollback(base: Path) -> None:
    home = base / "rollback-home"
    plugin_root = home / ".agents" / "plugins" / "plugins"
    old = plugin_root / PLUGIN
    old.mkdir(parents=True)
    (old / "sentinel.txt").write_text("old plugin", encoding="utf-8")
    market_path = home / ".agents" / "plugins" / "marketplace.json"
    market_path.parent.mkdir(parents=True, exist_ok=True)
    original_market = {
        "plugins": [
            {"name": PLUGIN, "source": {"source": "local", "path": f"./plugins/{PLUGIN}"}},
            {"name": "unrelated", "source": {"source": "local", "path": "./plugins/unrelated"}},
        ]
    }
    market_path.write_text(json.dumps(original_market, indent=2) + "\n", encoding="utf-8")
    agents = home / ".codex" / "agents"
    agents.mkdir(parents=True)
    original_profile = agents / "ams_existing.toml"
    original_profile.write_text(MANAGED + "\noriginal\n", encoding="utf-8")

    module = load_installer_module()
    args = module.parse_args(["--home", str(home), "--exclude-spark"])
    original_bootstrap = module.run_bootstrap

    def failing_bootstrap(root: Path, codex_home: Path, parsed: object, *, dry_run: bool, quiet: bool = False) -> None:
        if dry_run:
            return
        original_profile.write_text(MANAGED + "\nchanged\n", encoding="utf-8")
        (agents / "ams_new.toml").write_text(MANAGED + "\nnew\n", encoding="utf-8")
        (agents / "ams_user_during_failure.toml").write_text('name = "user"\n', encoding="utf-8")
        raise subprocess.CalledProcessError(7, ["bootstrap_profiles.py"])

    module.run_bootstrap = failing_bootstrap
    try:
        try:
            module.install(args)
        except subprocess.CalledProcessError:
            pass
        else:
            raise AssertionError("injected bootstrap failure did not fail installation")
    finally:
        module.run_bootstrap = original_bootstrap

    require((old / "sentinel.txt").read_text(encoding="utf-8") == "old plugin", "old plugin was not restored")
    require(marketplace(home) == original_market, "marketplace was not restored")
    require(not (home / ".codex" / "ams-orchestration.toml").exists(), "failed install left config")
    require(original_profile.read_text(encoding="utf-8") == MANAGED + "\noriginal\n", "profile was not restored")
    require(not (agents / "ams_new.toml").exists(), "new managed profile remained after rollback")
    require((agents / "ams_user_during_failure.toml").exists(), "rollback removed a concurrent unmarked user profile")
    require(not list((home / ".agents" / "plugins").glob(".ams-transaction-*")), "transaction directory rema