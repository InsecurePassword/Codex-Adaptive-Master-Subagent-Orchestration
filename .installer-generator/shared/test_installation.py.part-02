   custom_home = base / "custom-home"
        custom_codex = base / "custom-codex"
        env = dict(os.environ)
        env["CODEX_HOME"] = str(custom_codex)
        run(custom_home, "--exclude-spark", env=env)
        require((custom_codex / "ams-orchestration.toml").exists(), "CODEX_HOME config override was ignored")
        require((custom_codex / "agents").exists(), "CODEX_HOME profile override was ignored")
        require((custom_home / ".agents" / "plugins" / "plugins" / PLUGIN).exists(), "home plugin path was incorrect")

        step("manifest rejection")
        test_manifest_rejection(base)
        step("bootstrap timeout")
        test_timeout_helper(base)
        step("transaction rollback")
        test_rollback(base)
        step("install lock handling")
        test_install_lock(base)

        step("complete uninstall")
        legacy = home / ".agents" / "skills" / "ams-orchestration"
        legacy.mkdir(parents=True)
        (legacy / "legacy.txt").write_text("legacy", encoding="utf-8")
        user_profile = agents / "ams_user_profile.toml"
        user_profile.write_text('name = "user"\n', encoding="utf-8")
        stale_stage = home / ".codex" / ".ams-orchestration.toml.ams-uninstalling-old"
        stale_stage.write_text("stale", encoding="utf-8")
        stale_plugin = home / ".agents" / "plugins" / "plugins" / f".{PLUGIN}.ams-uninstalling-old"
        stale_plugin.mkdir(parents=True)
        (stale_plugin / "stale.txt").write_text("stale", encoding="utf-8")
        stale_backup = backups / f".{PLUGIN}.backup-old.ams-uninstalling-old"
        stale_backup.mkdir(parents=True)
        (stale_backup / "stale.txt").write_text("stale", encoding="utf-8")
        stale_profile = agents / ".ams_stale.toml.ams-uninstalling-old"
        stale_profile.write_text(MANAGED + "\nstale\n", encoding="utf-8")
        run(home, "--uninstall", "--yes")
        require(active_ams_plugins(home) == [], "uninstall left active AMS plugins")
        require(ams_marketplace_entries(home) == [], "uninstall left AMS marketplace entries")
        require((unrelated_plugin / "keep.txt").exists(), "uninstall removed unrelated plugin")
        require(any(item.get("name") == "unrelated" for item in marketplace(home)["plugins"]), "uninstall removed unrelated entry")
        require(user_profile.exists(), "uninstall removed an unmarked user profile")
        require(not config_path.exists(), "uninstall left user AMS config")
        require(not stale_stage.exists(), "uninstall left stale staged config")
        require(not stale_plugin.exists(), "uninstall left stale staged plugin")
        require(not stale_backup.exists(), "uninstall left stale staged backup")
        require(not stale_profile.exists(), "uninstall left stale staged profile")
        require(not legacy.exists(), "uninstall left legacy skill directory")
        require(not any(MANAGED in p.read_text(encoding="utf-8", errors="replace") for p in agents.iterdir() if p.is_file()), "uninstall left managed profiles")
        require(not any(path.name.startswith(tuple(ALL_NAMES)) for path in backups.iterdir()), "uninstall left AMS backups")

        step("empty uninstall")
        empty_home = base / "empty-uninstall"
        run(empty_home, "--uninstall", "--yes")
        require(not empty_home.exists(), "empty uninstall mutated home")

    print(f"INSTALLATION TESTS PASSED: option {OPTION}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
